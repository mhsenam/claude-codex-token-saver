{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${QODER_PLUGIN_ROOT}/dist/post-tool-use.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${QODER_PLUGIN_ROOT}/dist/pre-compact.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
