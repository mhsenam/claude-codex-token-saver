{
  "name": "token-saver",
  "version": "0.1.0",
  "private": true,
  "description": "Reduce Claude Code and Codex token usage with deterministic, recoverable tool-output compaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhsenam/claude-codex-token-saver.git"
  },
  "homepage": "https://github.com/mhsenam/claude-codex-token-saver",
  "keywords": [
    "claude-code",
    "codex",
    "token-optimization",
    "context-optimization",
    "mcp"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc",
    "test": "tsx --test packages/core/test/*.test.ts packages/mcp-server/test/*.test.ts packages/claude/test/*.test.ts packages/codex/test/*.test.ts",
    "benchmark": "tsx benchmarks/token-savings.ts",
    "smoke": "node scripts/smoke.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
